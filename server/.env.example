# Server
NODE_ENV=development
PORT=5000

# Client URL (used for CORS + links in emails)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/canadadigitoba?retryWrites=true&w=majority

# JWT (staff auth)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=cd_token

# Student portal auth — uses the same JWT_SECRET, a separate cookie so a
# portal session and a staff session never collide in the same browser.
PORTAL_JWT_COOKIE_NAME=cd_portal_token

# Email (SendGrid API — NOT raw SMTP). Railway blocks all outbound SMTP
# (confirmed live: ports 587/465/25 all time out from inside the
# container), so email goes over SendGrid's HTTPS API instead, which
# isn't affected by that.
#   1. Sign up at sendgrid.com (free tier: 100 emails/day).
#   2. Settings -> Sender Authentication -> verify a single sender (the
#      address you'll put in EMAIL_FROM below — SendGrid emails you a
#      confirmation link) or authenticate a whole domain if you own one.
#      SendGrid REJECTS sends from an address it hasn't verified.
#   3. Settings -> API Keys -> Create API Key (Restricted Access -> Mail
#      Send only is enough) -> copy it immediately, shown once.
# Until SENDGRID_API_KEY is filled in, emails are safely logged to the
# server console instead of sent — nothing breaks, it just won't deliver.
SENDGRID_API_KEY=
EMAIL_FROM="CanadaDigitoba <digitobaca@gmail.com>"

# Company inbox that gets notified of every new lead (optional)
NOTIFY_EMAIL=digitobaca@gmail.com

# WhatsApp / SMS — leave unset to run on the logging stub (see utils/messaging.js).
# Set WHATSAPP_PROVIDER once you have real credentials (e.g. "meta" or "twilio")
# and extend utils/messaging.js to call the provider's API.
WHATSAPP_PROVIDER=
SMS_PROVIDER=

# Payments — no live gateway wired in yet (see models/Payment.js). Set these
# once Razorpay/Stripe is chosen and extend controllers/paymentController.js
# with the gateway's webhook handler.
PAYMENT_PROVIDER=

# Document storage (Cloudflare R2 — S3-compatible, free tier, no egress
# fees). Until all four of these are set, uploads fall back to local disk
# (server/uploads/), which does NOT survive a deploy on almost any host —
# set these before going live, not after.
#   1. Cloudflare dashboard -> R2 -> Create bucket. Name it e.g. "canadadigitoba-uploads".
#   2. In the bucket's Settings, enable public access and copy the public
#      "r2.dev" URL (or connect your own domain) -> R2_PUBLIC_URL.
#   3. R2 -> Manage API tokens -> Create API token (Object Read & Write,
#      scoped to this bucket) -> copy the Account ID, Access Key ID, and
#      Secret Access Key below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
