# Server
NODE_ENV=development
PORT=5000

# Client URL (used for CORS + links in emails)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/canadadigitoba?retryWrites=true&w=majority

# JWT (staff auth)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=cd_token

# Student portal auth — uses the same JWT_SECRET, a separate cookie so a
# portal session and a staff session never collide in the same browser.
PORTAL_JWT_COOKIE_NAME=cd_portal_token

# Email (Gmail API — NOT raw SMTP). Railway blocks all outbound SMTP
# entirely (confirmed live: ports 587/465/25 all time out from inside the
# container), so email goes over the Gmail API's HTTPS endpoint instead —
# sending as digitobaca@gmail.com without any third-party email service or
# phone-verified signup. One-time setup, all inside your existing Google
# account (no new account, no billing):
#   1. console.cloud.google.com -> create a new project (any name).
#   2. APIs & Services -> Library -> search "Gmail API" -> Enable.
#   3. APIs & Services -> OAuth consent screen -> User Type "External" ->
#      fill in the required fields (app name, your email) -> Save. Leave
#      it in "Testing" mode (no Google review needed for personal use) ->
#      under "Test users", add digitobaca@gmail.com.
#   4. APIs & Services -> Credentials -> Create Credentials -> OAuth
#      client ID -> Application type "Web application" -> under
#      "Authorized redirect URIs" add exactly:
#        http://localhost:3939/oauth2callback
#      -> Create. Copy the Client ID and Client Secret into
#      GMAIL_CLIENT_ID / GMAIL_CLIENT_SECRET below.
#   5. Run `npm run auth:gmail` from server/ — it opens a Google consent
#      screen; log in as digitobaca@gmail.com and approve. It writes
#      GMAIL_REFRESH_TOKEN into this file automatically (never printed to
#      the terminal).
#   6. Copy all three GMAIL_* values into Railway's Variables tab too —
#      local .env and Railway need the same three values.
# Until all three are set, emails are safely logged to the server console
# instead of sent — nothing breaks, it just won't deliver for real.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_FROM="CanadaDigitoba <digitobaca@gmail.com>"

# Company inbox that gets notified of every new lead (optional)
NOTIFY_EMAIL=digitobaca@gmail.com

# WhatsApp / SMS — leave unset to run on the logging stub (see utils/messaging.js).
# Set WHATSAPP_PROVIDER once you have real credentials (e.g. "meta" or "twilio")
# and extend utils/messaging.js to call the provider's API.
WHATSAPP_PROVIDER=
SMS_PROVIDER=

# Payments — no live gateway wired in yet (see models/Payment.js). Set these
# once Razorpay/Stripe is chosen and extend controllers/paymentController.js
# with the gateway's webhook handler.
PAYMENT_PROVIDER=

# Document storage (Cloudflare R2 — S3-compatible, free tier, no egress
# fees). Until all four of these are set, uploads fall back to local disk
# (server/uploads/), which does NOT survive a deploy on almost any host —
# set these before going live, not after.
#   1. Cloudflare dashboard -> R2 -> Create bucket. Name it e.g. "canadadigitoba-uploads".
#   2. In the bucket's Settings, enable public access and copy the public
#      "r2.dev" URL (or connect your own domain) -> R2_PUBLIC_URL.
#   3. R2 -> Manage API tokens -> Create API token (Object Read & Write,
#      scoped to this bucket) -> copy the Account ID, Access Key ID, and
#      Secret Access Key below.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
